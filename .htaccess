# กันไฟล์ที่ไม่ควรเปิดผ่านเว็บ
<FilesMatch "^(config\.php|config\.sample\.php|composer\.(json|lock)|.*\.md)$">
    Require all denied
</FilesMatch>
Options -Indexes
RedirectMatch 404 /\.
RedirectMatch 404 ^/khlang/(lib|data|tools|fonts|vendor|storage)(/|$)

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(png|svg|woff2|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
